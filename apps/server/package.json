{
  "name": "@skill-manage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./router": {
      "types": "./dist/trpc/router.d.ts",
      "import": "./dist/trpc/router.js",
      "default": "./dist/trpc/router.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @skill-manage/prisma db:generate",
    "db:push": "pnpm --filter @skill-manage/prisma db:push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@skill-manage/prisma": "workspace:*",
    "@skill-manage/shared": "workspace:*",
    "@trpc/server": "^11.31.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "jszip": "^3.10.2",
    "mime": "^4.1.1",
    "pg": "^8.23.1",
    "superjson": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
