// 用户与业务表统一放在 skills schema

generator client {
  provider = "prisma-client"
  output   = "./src"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  RESIGNED
}

model User {
  id             String     @id
  account        String     @unique
  password       String
  displayName    String
  phone          String?
  role           UserRole   @default(USER)
  status         UserStatus @default(ACTIVE)
  token          String?    @unique
  tokenExpiredAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  email          String?

  @@map("users")
}

model SkillSet {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String
  description String?
  /// 自定义图标，data URL（data:image/...;base64,...）
  icon        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills SkillSetSkill[]

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("skill_sets")
}

model Skill {
  id              String   @id @default(cuid())
  ownerId         String
  slug            String
  displayName     String
  summary         String?
  /// 列表展示用标签（上传时写入，不依赖 version.metadata）
  tags            String[] @default([])
  /// 自定义图标，data URL（data:image/...;base64,...）
  icon            String?  @db.Text
  latestVersionId String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skillSets     SkillSetSkill[]
  versions     SkillVersion[]
  latestVersion SkillVersion? @relation("SkillLatestVersion", fields: [latestVersionId], references: [id], onDelete: SetNull)

  @@unique([ownerId, slug])
  @@index([ownerId])
  @@map("skills")
}

model SkillSetSkill {
  id         String   @id @default(cuid())
  skillSetId String
  skillId    String
  createdAt  DateTime @default(now())

  skillSet SkillSet @relation(fields: [skillSetId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillSetId, skillId])
  @@index([skillId])
  @@map("skill_set_skills")
}

model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  version     String
  storageKey  String
  fileCount   Int      @default(0)
  totalSize   BigInt   @default(0)
  changelog   String?
  /// SKILL.md 完整 frontmatter（全部 meta 字段）
  metadata    Json?
  createdAt   DateTime @default(now())

  skill           Skill               @relation(fields: [skillId], references: [id], onDelete: Cascade)
  latestForSkills Skill[]             @relation("SkillLatestVersion")
  files           SkillFile[]
  downloadLinks   SkillDownloadLink[]

  @@unique([skillId, version])
  @@index([skillId])
  @@map("skill_versions")
}

/// MCP 下载短链：凭 token 匿名拉取 zip，到期失效
model SkillDownloadLink {
  id        String   @id @default(cuid())
  token     String   @unique
  versionId String
  /// 创建者 userId（审计）
  createdBy String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  version SkillVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([versionId])
  @@map("skill_download_links")
}

model SkillFile {
  id         String   @id @default(cuid())
  versionId  String
  filePath   String
  storageKey String
  sha256     String
  fileSize   BigInt
  contentType String?
  createdAt  DateTime @default(now())

  version SkillVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, filePath])
  @@index([versionId])
  @@map("skill_files")
}
